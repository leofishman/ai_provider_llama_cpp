<?php

/**
 * @file
 * Install, update, and uninstall functions for the llama.cpp provider module.
 */

/**
 * Implements hook_uninstall().
 */
function ai_provider_llama_cpp_uninstall() {
  $state = \Drupal::state();
  $entity_type_manager = \Drupal::entityTypeManager();

  // Delete model config entities (new storage).
  $model_storage = $entity_type_manager->getStorage('llama_cpp_model');
  foreach ($model_storage->loadMultiple() as $model) {
    $model->delete();
  }

  // Clean up any remaining per-server state model keys (from pre-refactor).
  $servers = $entity_type_manager
    ->getStorage('llama_cpp_server')
    ->loadMultiple();
  foreach ($servers as $server) {
    $prefix = 'ai_provider_llama_cpp.server.' . $server->id();
    $state->delete("{$prefix}.models");
    $state->delete("{$prefix}.model_types");
    $state->delete("{$prefix}.model_overrides");
  }

  // Clean up legacy state keys (pre-1.2.x).
  $state->delete('ai_provider_llama_cpp.models');
  $state->delete('ai_provider_llama_cpp.model_types');
  $state->delete('ai_provider_llama_cpp.model_overrides');
  $state->delete('ai_provider_llama_cpp.hf_tag_cache');
}

/**
 * Migrate single-server config to multi-server config entities.
 */
function ai_provider_llama_cpp_update_10201() {
  // Ensure the config entity type is installed.
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if (!$update_manager->getEntityType('llama_cpp_server')) {
    $entity_type = \Drupal::entityTypeManager()->getDefinition('llama_cpp_server');
    $update_manager->installEntityType($entity_type);
  }

  $config_factory = \Drupal::configFactory();
  $config = $config_factory->get('ai_provider_llama_cpp.settings');

  $host = $config->get('host_name');
  $port = $config->get('port');

  if (!$host) {
    // Nothing to migrate.
    return t('No existing server configuration found. Skipping migration.');
  }

  // Create a "default" config entity with the existing values.
  $storage = \Drupal::entityTypeManager()->getStorage('llama_cpp_server');

  // Avoid collision if re-running.
  if ($storage->load('default')) {
    return t('Server "default" already exists. Skipping migration.');
  }

  $server = $storage->create([
    'id' => 'default',
    'label' => 'llama.cpp (migrated)',
    'host_name' => $host,
    'port' => $port ?: '8080',
    'api_key' => '',
    'timeout' => 600,
    'operation_types' => [],
  ]);
  $server->save();

  // Migrate state keys to per-server namespace.
  $state = \Drupal::state();
  $keys = ['models', 'model_types', 'model_overrides'];
  foreach ($keys as $key) {
    $old_key = "ai_provider_llama_cpp.{$key}";
    $new_key = "ai_provider_llama_cpp.server.default.{$key}";
    $value = $state->get($old_key);
    if ($value !== NULL) {
      $state->set($new_key, $value);
      $state->delete($old_key);
    }
  }

  // Update AI module default_providers: llama_cpp → llama_cpp:default.
  $ai_config = $config_factory->getEditable('ai.settings');
  $defaults = $ai_config->get('default_providers') ?? [];
  $changed = FALSE;
  foreach ($defaults as $op_type => $provider_info) {
    if (($provider_info['provider_id'] ?? '') === 'llama_cpp') {
      $defaults[$op_type]['provider_id'] = 'llama_cpp:default';
      $changed = TRUE;
    }
  }
  if ($changed) {
    $ai_config->set('default_providers', $defaults)->save();
  }

  // Delete the old simple config.
  $config_factory->getEditable('ai_provider_llama_cpp.settings')->delete();

  return t('Migrated server configuration to entity "default" (llama_cpp:default).');
}

/**
 * Migrate plaintext API keys to Key module entities.
 */
function ai_provider_llama_cpp_update_10202() {
  // Ensure the config entity type is installed.
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if (!$update_manager->getEntityType('llama_cpp_server')) {
    $entity_type = \Drupal::entityTypeManager()->getDefinition('llama_cpp_server');
    $update_manager->installEntityType($entity_type);
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $server_storage = $entity_type_manager->getStorage('llama_cpp_server');
  $key_storage = $entity_type_manager->getStorage('key');
  $migrated = 0;

  /** @var \Drupal\ai_provider_llama_cpp\Entity\LlamaCppServerInterface $server */
  foreach ($server_storage->loadMultiple() as $server) {
    $api_key = $server->getApiKey();
    if ($api_key === '') {
      continue;
    }

    // Already references a Key entity.
    if ($key_storage->load($api_key)) {
      continue;
    }

    $key_id = 'llama_cpp_' . $server->id();
    if (!$key_storage->load($key_id)) {
      $key_storage->create([
        'id' => $key_id,
        'label' => 'llama.cpp: ' . $server->label(),
        'key_type' => 'authentication',
        'key_type_settings' => [],
        'key_provider' => 'config',
        'key_provider_settings' => [
          'key_value' => $api_key,
        ],
        'key_input' => 'text_field',
        'description' => 'Migrated from llama.cpp server configuration.',
      ])->save();
    }

    $server->set('api_key', $key_id);
    $server->save();
    $migrated++;
  }

  return t('Migrated @count server API key(s) to Key entities.', ['@count' => $migrated]);
}

/**
 * Migrate derived plugin IDs (llama_cpp:server) to a single plugin + models.
 */
function ai_provider_llama_cpp_update_10203() {
  // Ensure the new model entity type is installed.
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if (!$update_manager->getEntityType('llama_cpp_model')) {
    $entity_type = \Drupal::entityTypeManager()->getDefinition('llama_cpp_model');
    $update_manager->installEntityType($entity_type);
  }

  $state = \Drupal::state();
  $model_storage = \Drupal::entityTypeManager()->getStorage('llama_cpp_model');
  $server_storage = \Drupal::entityTypeManager()->getStorage('llama_cpp_server');

  // 1. Migrate old State-based model data (pre-refactor derivers) into
  //    llama_cpp_model config entities FIRST, so the default_providers rewrite
  //    below can remap each model_id reference to the new entity id.
  foreach ($server_storage->loadMultiple() as $server) {
    $sid = $server->id();
    $prefix = "ai_provider_llama_cpp.server.{$sid}";
    $old_models = $state->get("{$prefix}.models", []);
    $old_types = $state->get("{$prefix}.model_types", []);
    $old_overrides = $state->get("{$prefix}.model_overrides", []);

    foreach ($old_models as $machine => $raw) {
      $eid = $sid . '__' . $machine;
      if ($model_storage->load($eid)) {
        continue;
      }
      $model_storage->create([
        'id' => $eid,
        'label' => $server->label() . ' / ' . $raw,
        'server_id' => $sid,
        'raw_model_id' => $raw,
        'detected_operation_types' => $old_types[$machine] ?? ['chat'],
        'operation_types' => $old_overrides[$machine] ?? [],
      ])->save();
    }

    // Old state keys are left in place; hook_uninstall() cleans them up.
  }

  // 2. Rewrite ai.settings.default_providers: collapse derived provider ids
  //    (llama_cpp:server) to the single 'llama_cpp' plugin, and remap each
  //    model_id from the old per-server machine name to the new entity id
  //    ("server__machine") whenever the migrated model entity exists.
  $ai_config = \Drupal::configFactory()->getEditable('ai.settings');
  $defaults = $ai_config->get('default_providers') ?? [];
  $changed = FALSE;
  $mapped = [];
  $unmapped = [];

  foreach ($defaults as $op_type => $provider_info) {
    $pid = $provider_info['provider_id'] ?? '';
    if (!str_starts_with($pid, 'llama_cpp:')) {
      continue;
    }

    $server_id = substr($pid, strlen('llama_cpp:'));
    $defaults[$op_type]['provider_id'] = 'llama_cpp';
    $changed = TRUE;

    $old_model = $provider_info['model_id'] ?? '';
    if ($old_model === '') {
      continue;
    }
    $new_model = $server_id . '__' . $old_model;
    if ($model_storage->load($new_model)) {
      $defaults[$op_type]['model_id'] = $new_model;
      $mapped[] = $op_type;
    }
    else {
      $unmapped[] = $op_type;
    }
  }

  if ($changed) {
    $ai_config->set('default_providers', $defaults)->save();
  }

  if (!$changed) {
    return t('No derived llama_cpp provider references found.');
  }
  if ($unmapped) {
    return t('Migrated llama.cpp providers. Remapped models for: @mapped. Could not auto-map models for: @unmapped — please re-select them in the AI settings.', [
      '@mapped' => implode(', ', $mapped) ?: '-',
      '@unmapped' => implode(', ', $unmapped),
    ]);
  }
  return t('Migrated llama.cpp providers and remapped models for: @mapped.', [
    '@mapped' => implode(', ', $mapped),
  ]);
}
